{
  "name": "3dbrain",
  "description": "ThreeJS Brain Visualization",
  "version": "2.0.1",
  "main": "dist/amelia_brain.js",
  "keywords": [
    "amelia",
    "brain",
    "ai"
  ],
  "author": "Victor Santos",
  "license": "MIT",
  "scripts": {
    "dev": "webpack-dev-server --inline --progress --host 0.0.0.0 --config build/webpack.dev.conf.js",
    "start": "npm run dev",
    "lint": "eslint --ext .js src --fix",
    "build": "node build/build.js",
    "vercel-build": "npm run build",
    "dist": "build/webpack.prod.conf.js",
    "test": "jest",
    "test:clean": "rimraf ./coverage",
    "test:watch": "jest --watch",
    "test:watchAll": "jest --watchAll",
    "test:coverage:report": "open ./coverage/lcov-report/index.html",
    "deploy": "npm run build && firebase deploy"
  },
  "engines": {
    "node": "18.x",
    "npm": ">=8.x"
  },
  "dependencies": {
    "@superguigui/wagner": "^0.1.6",
    "dat-gui": "^0.5.0",
    "findup": "^0.1.5",
    "glsl-checker": "^1.0.1",
    "glsl-noise": "0.0.0",
    "glslify-fancy-imports": "^1.0.1",
    "glslify-hex": "^2.0.1",
    "gsap": "^3.12.0",
    "lodash": "^4.17.21",
    "postprocessing": "^4.5.0",
    "socket.io-client": "^2.1.1",
    "three": "^0.153.0",
    "three-bas": "^2.7.0",
    "yeast": "^0.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/eslint-parser": "^7.22.0",
    "@babel/preset-env": "^7.22.0",
    "@babel/plugin-transform-runtime": "^7.22.0",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.2",
    "babel-plugin-glslify": "^2.0.0",
    "babel-plugin-syntax-jsx": "^6.18.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.42.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-friendly-formatter": "^4.0.1",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-webpack-plugin": "^4.0.1",
    "file-loader": "^6.2.0",
    "friendly-errors-webpack-plugin": "^1.7.0",
    "glslify": "^7.1.1",
    "glslify-loader": "^2.0.0",
    "html-webpack-plugin": "^5.5.1",
    "jest": "^29.5.0",
    "optimize-css-assets-webpack-plugin": "^6.0.1",
    "postcss-import": "^15.1.0",
    "postcss-loader": "^7.3.2",
    "raw-loader": "^4.0.2",
    "rimraf": "^5.0.1",
    "shelljs": "^0.8.5",
    "style-loader": "^3.3.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.85.0",
    "webpack-cli": "^5.1.1",
    "webpack-dev-server": "^4.15.0",
    "webpack-merge": "^5.9.0"
  },
  "browserify": {
    "transform": [
      [
        "babelify",
        {
          "presets": [
            "@babel/preset-env"
          ],
          "plugins": [
            "glslify"
          ]
        }
      ],
      "glslify"
    ]
  },
  "glslify": {
    "transform": [
      "glslify-fancy-imports",
      "glslify-hex"
    ]
  }
}
